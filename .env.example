# Copia este archivo como ".env" (sin ".example") en la misma carpeta
# donde está docker-compose.yml, y ajusta los valores si quieres.
# Si no creas el .env, docker-compose usa estos mismos valores por defecto.

# Contraseña del usuario root de la base de datos dentro de los contenedores
DB_ROOT_PASSWORD=unicreditos_root

# URL donde el NAVEGADOR del usuario va a poder alcanzar el backend.
# Si despliegas esto en un servidor real, cámbialo por la IP o dominio real,
# por ejemplo: http://tu-servidor.com:8080/api
VITE_API_URL=http://localhost:8080/api